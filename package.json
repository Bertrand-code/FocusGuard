{
  "name": "focusguard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/extension",
    "apps/web",
    "packages/*",
    "tests/bypass-lab"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security": "npm run security:secrets && npm audit --audit-level=high",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run security:secrets"
  },
  "engines": {
    "node": ">=22"
  }
}
